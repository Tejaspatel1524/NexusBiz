# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# REQUIRED: Replace with your actual Neon/Postgres connection string
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# Authentication
# REQUIRED: This is a random secret for development. Change for production!
JWT_SECRET=nexusbiz-dev-secret-key-$(openssl rand -hex 32 2>/dev/null || echo "random-string-12345")
JWT_EXPIRES_IN=7d

# AI Configuration
# Get your key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama Local AI Configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:70b
OLLAMA_ENABLED=true

# Frontend URL
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
